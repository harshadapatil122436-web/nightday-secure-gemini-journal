rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if caller matches specific user ID
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // User document and all user scoped subcollections
    match /users/{uid} {
      allow get, list, create, update, delete: if isOwner(uid);

      match /{allSubcollections=**} {
        allow get, list, create, update, delete: if isOwner(uid);
      }
    }

    match /users/{uid}/journal_entries/{entryId} {
      allow get, list, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/entries/{entryId} {
      allow get, list, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/chat_messages/{messageId} {
      allow get, list, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/summaries/{summaryId} {
      allow get, list, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/profile/{docId} {
      allow get, list, create, update, delete: if isOwner(uid);
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


